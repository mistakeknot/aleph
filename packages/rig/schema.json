{
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "bb.rig/v1"
    },
    "kind": {
      "type": "string",
      "const": "Rig"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "extensionPoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["extensionPoints"],
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "source": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "builtin": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                  }
                },
                "required": ["builtin"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["path"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "git": {
                    "type": "string",
                    "format": "uri"
                  },
                  "ref": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "subdir": {
                    "default": ".",
                    "type": "string"
                  }
                },
                "required": ["git", "ref", "subdir"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "npm": {
                    "type": "string",
                    "pattern": "^(@[a-z0-9-]+\\/)?[a-z0-9-]+$"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
                  }
                },
                "required": ["npm", "version"],
                "additionalProperties": false
              }
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "settings": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "requires": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "source",
          "version",
          "enabled",
          "settings",
          "requires"
        ],
        "additionalProperties": false
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "source": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "builtin": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                  }
                },
                "required": ["builtin"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["path"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "git": {
                    "type": "string",
                    "format": "uri"
                  },
                  "ref": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "subdir": {
                    "default": ".",
                    "type": "string"
                  }
                },
                "required": ["git", "ref", "subdir"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "npm": {
                    "type": "string",
                    "pattern": "^(@[a-z0-9-]+\\/)?[a-z0-9-]+$"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
                  }
                },
                "required": ["npm", "version"],
                "additionalProperties": false
              }
            ]
          },
          "targets": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["bb", "claude", "codex", "agents"]
            }
          }
        },
        "required": ["id", "source", "targets"],
        "additionalProperties": false
      }
    },
    "agents": {
      "type": "object",
      "properties": {
        "claude": {
          "type": "object",
          "properties": {
            "settings": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "hooks": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": ["settings", "hooks"],
          "additionalProperties": false
        },
        "codex": {
          "type": "object",
          "properties": {
            "settings": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "hooks": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": ["settings", "hooks"],
          "additionalProperties": false
        }
      },
      "required": ["claude", "codex"],
      "additionalProperties": false
    },
    "accountPool": {
      "type": "object",
      "properties": {
        "settings": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "provider": {
                "type": "string",
                "enum": ["claude", "codex"]
              },
              "credential": {
                "type": "object",
                "properties": {
                  "secretRef": {
                    "type": "string",
                    "pattern": "^(env:[A-Z_][A-Z0-9_]*|store:[A-Za-z0-9._/-]+)$"
                  }
                },
                "required": ["secretRef"],
                "additionalProperties": false
              },
              "config": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            },
            "required": ["id", "provider", "credential", "config"],
            "additionalProperties": false
          }
        }
      },
      "required": ["settings", "accounts"],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "compatibility",
    "plugins",
    "skills",
    "agents",
    "accountPool"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
